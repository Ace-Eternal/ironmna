MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
DB_USERNAME=iron_app
DB_PASSWORD=replace_with_strong_app_password
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example
APP_AUTH_ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false
MATERIAL_RECOGNITION_API_KEY=

